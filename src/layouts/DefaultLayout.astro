---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TeamPanel from "../components/Team.astro";
import Audio from "../components/Audio.astro";

const { title = "Melvin's Pokedex" } = Astro.props;
---

<html lang="en">
    <Head title={title} />

    <body>
        <!-- Header -->
        <Header />

        <!-- Page content -->
        <main>
            <slot />
        </main>

        <!-- Team Panel -->
        <TeamPanel />

        <!-- Audio -->
        <Audio />

        <!-- Footer -->
        <Footer />

    </body>
</html>
