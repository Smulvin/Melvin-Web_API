---
// @ts-nocheck
const { pokemonName } = Astro.props;

let pokemon = null;

try {
  const res = await fetch(
    `https://pokeapi.co/api/v2/pokemon/${pokemonName.toLowerCase()}`,
  );
  pokemon = await res.json();
} catch (err) {
  console.error("Error fetching Pokémon:", err);
}
---

{
  pokemon && (
    <a href={`/pokemon/${pokemon.name}`} class="card-link">
      <div class="card">
        <img
          src={pokemon.sprites.other["official-artwork"].front_default}
          alt={pokemon.name}
          class="image"
        />

        <h2 class="title">{pokemon.name}</h2>

        <div class="types">
          {pokemon.types.map((typeObj) => (
            <span class={`type type-${typeObj.type.name}`}>
              {typeObj.type.name}
            </span>
          ))}
        </div>
        <button
          class="add-btn"
          onclick={`event.stopPropagation(); event.preventDefault();
            addToTeam({
              name: '${pokemon.name}',
              image: '${pokemon.sprites.other["official-artwork"].front_default}'
            });
            animateAdd(event);
          `}
        >
          <i class="fa-solid fa-plus" />
        </button>
      </div>
    </a>
  )
}

<template>
  <img class="flying-image" />
</template>

<script is:inline>
  function animateAdd(e) {
    const card = e.currentTarget.closest(".card");
    const template = document.querySelector("template");

    if (!card || !template) return;

    const clone = template.content.firstElementChild.cloneNode(true);
    document.body.appendChild(clone);

    const rect = card.getBoundingClientRect();

    const startX = rect.left + rect.width / 2 - 64;
    const startY = rect.top + rect.height / 2 - 64;

    clone.style.position = "fixed";
    clone.style.left = `${startX}px`;
    clone.style.top = `${startY}px`;

    clone.style.background = `url(${card.querySelector("img").src})`;
    clone.style.backgroundSize = "cover";
    clone.style.backgroundPosition = "center";

    // POP phase
    clone.style.transform = "scale(0.8)";
    clone.style.opacity = "1";
    clone.style.transition = "transform 0.15s cubic-bezier(.34,1.56,.64,1)";

    clone.getBoundingClientRect(); // force reflow

    clone.style.transform = "scale(1.2)";

    setTimeout(() => {
      const endX = window.innerWidth + 100;
      const endY = window.innerHeight / 2 - 64;

      // IMPORTANT: force reflow before switching transition
      clone.getBoundingClientRect();

      clone.style.transition = "all 0.7s ease";
      clone.style.left = `${endX}px`;
      clone.style.top = `${endY}px`;
      clone.style.opacity = "0";
      clone.style.transform = "scale(0.6)";

      clone.addEventListener("transitionend", (event) => {
        if (event.propertyName !== "opacity") return;
        clone.remove();
      });
    }, 150);
  }
</script>

<style>
  .card-link {
    text-decoration: none;
  }

  .card {
    max-width: 200px;
    background:
        linear-gradient(135deg, var(--detail-bg-light) 0 50%, transparent 50%),
        linear-gradient(225deg, var(--detail-bg-normal) 0 50%, transparent 50%),
        linear-gradient(315deg, var(--detail-bg-dark) 0 50%, transparent 50%);
    border: 5px solid var(--detail-container-border);
    border-radius: 1.6rem;
    padding: 1rem 0;
    color: black;
    text-decoration: none;
    position: relative;
    
    img {
      aspect-ratio: 1;
      width: 90%;
      position: relative;
      border-radius: 50%;
      padding: 1rem;
      background: var(--detail-container-bg);
      border: 5px solid var(--detail-container-border);
      border-radius: 50%;
      transition: 0.3s;
    }

    h2 {
      background: var(--detail-container-bg);
      border: 5px solid var(--detail-container-border);
      border-left: 0;
      corner-shape: bevel;
      border-radius: 0 0 5rem 0;
    }

    &:hover img {
      scale: 1.1;
      animation: rotate 3s linear infinite;
      background: linear-gradient(
        180deg,
        var(--color-pokeball) 48%,
        var(--color-pokeball-rim) 48%,
        var(--color-pokeball-rim) 52%,
        var(--color-pokeball-bottom) 52%
      );
      transition: 0.3s;
    }
  }

  @keyframes rotate {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .card button {
    background: var(--color-green);
    top: -1rem;
    right: -1rem;
  }

  .image {
    width: 128px;
    aspect-ratio: 1;
    display: block;
    margin: 0 auto;
    position: relative;
    z-index: 3;
  }

  .title {
    text-align: center;
    font-weight: bold;
    margin-top: 0.5rem;
    text-transform: capitalize;
    font-size: 1.25rem;
  }

  .flying-image {
    position: fixed;
    width: 128px;
    aspect-ratio: 1;
    pointer-events: none;
    z-index: 9999;
    background-size: cover;
  }
</style>
